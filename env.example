# Baloot Game Environment Configuration

# Server
PORT=8080
NODE_ENV=development

# Game Settings
MAX_ROOMS=100
MAX_PLAYERS_PER_ROOM=4
BOT_DIFFICULTY=expert
GAME_TIMEOUT=30000

# Features
ENABLE_CHAT=true
ENABLE_EMOJI=true
ENABLE_ANIMATIONS=true
ENABLE_SOUND=true

# Security
RATE_LIMIT=100
RATE_WINDOW=60000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Redis (Optional - for production)
# REDIS_URL=redis://localhost:6379

# Database (Optional - for user accounts)
# DATABASE_URL=postgresql://user:pass@localhost:5432/baloot